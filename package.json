{
  "name": "omp-pty",
  "version": "0.1.0",
  "description": "Persistent PTY session tools for Oh My Pi / OMP coding agent sessions.",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src/**",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "omp-package",
    "omp-extension",
    "pi-extension",
    "pty",
    "terminal",
    "interactive",
    "watch"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/anton1615/omp-pty.git"
  },
  "homepage": "https://github.com/anton1615/omp-pty#readme",
  "bugs": {
    "url": "https://github.com/anton1615/omp-pty/issues"
  },
  "scripts": {
    "test": "bun test index.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run test && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "bun-pty": "^0.4.10"
  },
  "omp": {
    "extensions": ["./index.ts"]
  }
}
